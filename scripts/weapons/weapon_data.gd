class_name WeaponData
extends Resource

## Идентификатор типа оружия (например: &"caliber_0", &"anvil", &"injector", &"sewing_machine")
@export var weapon_id: StringName = &""

## Отображаемое название оружия в HUD (например: "КАЛИБР-0")
@export var name: String = ""

## Вместимость магазина (максимальный боезапас)
@export var max_ammo: int = 1

## Прямой базовый урон одного снаряда / дробинки
## Калибр-0: 70 HP; Кровавая наковальня: 12 HP на дробинку; Инъектор: 10 HP (очередь из 3 = 30 HP); Швейная машина: 6 HP
@export var damage: int = 0

## Количество дробинок / пуль за один выстрел (1 для обычных, 8 для дробовика)
@export var pellets: int = 1

## Конус разброса выстрела
## Наковальня: 0.085 (~8-10 градусов); Инъектор: 0.045 (~4-5 градусов); Швейная машина: 0.02; Калибр-0: 0.0
@export var spread: float = 0.0

## Интервал между выстрелами в секундах
## Калибр-0: 1.0с (ровно 1.0 секунда между выстрелами); Наковальня: 0.5с; Инъектор: 0.28с (кулдаун между очередями); Швейная машина: 0.1с (10 выстрелов/сек)
@export var fire_rate: float = 1.0

## Время полной перезарядки магазина в секундах (активной и фоновой пассивной)
@export var reload_time: float = 1.0

## Травма / интенсивность тряски камеры при выстреле
@export var cam_shake: float = 0.0

## Интенсивность отдачи view-model оружия
@export var weapon_kick: float = 0.0

## Горизонтальный толчок / импульс от пули
## Калибр-0: 4.5 (толчок от крупного калибра); Наковальня: 6.0 (сильный толчок назад); Инъектор: 1.5; Швейная машина: 1.0
@export var knockback: float = 0.0

## Вертикальный подброс цели в воздух
## Наковальня: 7.0 (подбрасывает в воздух для синергий); Калибр-0 / Инъектор / Швейная машина: 0.0 (не подбрасывают вверх)
@export var upward_kick: float = 0.0

## Множитель урона при попадании в хитбокс головы
## Калибр-0: 2.2 (хедшот: 70 * 2.2 = 154 ваншот); Наковальня / Инъектор / Швейная машина: 1.5
@export var headshot_multiplier: float = 1.0

## Множитель урона по воздушным целям
## Калибр-0: 2.0 (бонус x2 по воздушным целям, стакается с хедшотом); Остальные: 1.0
@export var air_multiplier: float = 1.0

## Создаёт ли пуля вакуумный след вдоль траектории полёта, затягивающий врагов (true для Калибр-0)
@export var has_vacuum: bool = false

## Радиус затягивания вакуумного следа (2.5м для Калибр-0)
@export var vacuum_radius: float = 0.0

## Сила стягивающего импульса вакуумного следа (25.6 для Калибр-0)
@export var vacuum_force: float = 0.0

## Флаг автоматической непрерывной стрельбы при удержании ЛКМ (true для Швейной машины)
@export var is_automatic: bool = false
